<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Clinton Hamisi</title>
</head>
<body>
    <h1>Contact Me</h1>
    <p>Fill out the form below and I'll get back to you.</p>

    <form action="#" method="post">
        <fieldset>
            <legend>Personal Information</legend>

            <p>
                <label for="name">Full Name *</label><br>
                <input type="text" id="name" name="name"
                       placeholder="Clinton Hamisi" required>
            </p>

            <p>
                <label for="email">Email *</label><br>
                <input type="email" id="email" name="email"
                       placeholder="clinton@example.com" required>
            </p>

            <p>
                <label for="phone">Phone (optional)</label><br>
                <input type="tel" id="phone" name="phone"
                       placeholder="+254 7XX XXX XXX">
            </p>
        </fieldset>

        <fieldset>
            <legend>Your Message</legend>

            <p>
                <label for="subject">Subject *</label><br>
                <select id="subject" name="subject" required>
                    <option value="">-- Choose a subject --</option>
                    <option value="general">General Inquiry</option>
                    <option value="project">Project Collaboration</option>
                    <option value="feedback">Feedback</option>
                </select>
            </p>

            <p>
                <label for="message">Message * (minimum 50 characters)</label><br>
                <textarea id="message" name="message" rows="6"
                          minlength="50" required
                          placeholder="Write at least 50 characters..."></textarea>
            </p>

            <p>
                <label>
                    <input type="checkbox" name="newsletter" value="yes">
                    Subscribe to my newsletter
                </label>
            </p>
        </fieldset>

        <button type="submit">Send Message</button>
    </form>
</body>
</html>
